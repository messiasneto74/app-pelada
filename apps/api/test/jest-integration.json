{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testMatch": [
    "<rootDir>/**/*.integration-spec.ts",
    "<rootDir>/../src/**/*.integration.spec.ts",
    "<rootDir>/sign-test-jwt.spec.ts"
  ],
  "setupFiles": ["<rootDir>/setup-integration-db-harness.ts"],
  "maxWorkers": 1,
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/../tsconfig.spec.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^@pelada/core$": "<rootDir>/../../../packages/core/dist/index.js"
  }
}

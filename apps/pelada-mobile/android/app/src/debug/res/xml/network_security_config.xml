<?xml version="1.0" encoding="utf-8"?>
<!-- Build debug apenas: permite HTTP (cleartext) pra API/Keycloak locais durante
     validação manual em device/emulador. Nunca entra no build de produção.

     Libera cleartext de forma geral (base-config), não por IP fixo: a API/Keycloak
     de dev rodam no IP da LAN de quem está testando (varia por rede/máquina —
     10.0.2.2 no emulador, 192.168.x.x em device físico etc.), e o Android não
     aceita wildcard de IP em <domain>, só de subdomínio. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>

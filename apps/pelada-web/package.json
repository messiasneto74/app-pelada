{
  "name": "@pelada/web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prestart": "npm run build -w @pelada/core",
    "prebuild": "npm run build -w @pelada/core",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run build -w @pelada/core",

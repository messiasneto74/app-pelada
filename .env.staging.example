# =============================================================================
# Staging (DEPLOY-1) — copiar para .env no VPS ou exportar antes do build web.
# Nunca commitar .env com valores reais. Ver docs/deploy-staging.md
# =============================================================================

# URLs públicas (HTTPS) — usadas pela API, Keycloak e build Angular
STAGING_PELADA_WEB_URL=https://app.staging.seudominio.com
STAGING_PELADA_API_URL=https://api.staging.seudominio.com
STAGING_KEYCLOAK_URL=https://auth.staging.seudominio.com

PELADA_WEB_URL=https://app.staging.seudominio.com
PELADA_API_URL=https://api.staging.seudominio.com
KEYCLOAK_URL=https://auth.staging.seudominio.com
KEYCLOAK_REALM=pelada
KEYCLOAK_CLIENT_ID=pelada-web

KEYCLOAK_ISSUER=https://auth.staging.seudominio.com/realms/pelada
KEYCLOAK_JWKS_URI=https://auth.staging.seudominio.com/realms/pelada/protocol/openid-connect/certs

# Keycloak atrás de reverse proxy TLS (repassado ao container no docker-compose.yml)
KEYCLOAK_PUBLIC_HOSTNAME=auth.staging.seudominio.com
KC_PROXY_HEADERS=xforwarded

API_PORT=3000
PORT=3000
CORS_ORIGIN=https://app.staging.seudominio.com
DEV_AUTH_BYPASS=false

# Postgres / Keycloak no compose (rede interna — não expor na internet)
DATABASE_URL=postgresql://pelada_app:ALTERE_AQUI@postgres-app:5432/pelada_app
POSTGRES_APP_USER=pelada_app
POSTGRES_APP_PASSWORD=ALTERE_AQUI
POSTGRES_KEYCLOAK_USER=keycloak
POSTGRES_KEYCLOAK_PASSWORD=ALTERE_AQUI
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=ALTERE_AQUI

PUBLIC_UPLOAD_BASE_URL=https://api.staging.seudominio.com/uploads

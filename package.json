{
  "name": "app-pelada",
  "version": "0.0.1",
  "private": true,
  "description": "App de pelada — monorepo Angular, API Nest e core de sorteio",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run start -w @pelada/web",
    "dev:api": "npm run start:dev -w @pelada/api",
    "build:web": "npm run build -w @pelada/web",
    "build:api": "npm run build -w @pelada/api",
    "build:core": "npm run build -w @pelada/core",
    "test:core": "npm run test -w @pelada/core",
    "test:api": "npm run test -w @pelada/api",
    "test:web": "npm run test -w @pelada/web",
    "test:scripts": "vitest run --config vitest.config.mjs",
    "test:scripts:cov": "vitest run --config vitest.config.mjs --coverage",
    "test:scripts:r07": "npm run test:scripts:cov && node scripts/check-pr-line-coverage.mjs",
    "test:all": "npm run test:core && npm run test:api && npm run test:web && npm run test:scripts:r07",
    "issue:mark-dod": "node scripts/mark-issue-dod.mjs",
    "db:up": "docker compose up -d postgres-app",
    "db:down": "docker compose down",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f --tail=100",
    "smoke:stack": "node scripts/stack-smoke.mjs",
    "db:migrate": "npm run prisma:migrate:deploy -w @pelada/api",
    "keycloak:up": "docker compose up -d postgres-keycloak keycloak",
    "keycloak:down": "docker compose stop keycloak postgres-keycloak",
    "keycloak:reset": "node scripts/keycloak-reset.mjs",
    "smoke:keycloak": "node scripts/keycloak-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.0",
    "vitest": "^3.2.0"
  }
}

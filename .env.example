# =============================================================================
# App Pelada — variáveis de ambiente (cópia para .env na raiz)
# Nunca commitar .env com senhas reais.
#
# DOC-1: índice rápido
#   Dev local  → este arquivo + docs/desenvolvimento-local.md
#   Auth/OIDC  → docs/ambiente-dev-auth.md
#   Staging    → .env.staging.example + docs/deploy-staging.md
#   Testes API → DATABASE_URL_TEST (harness :5435)
#   E2E        → PELADA_* abaixo (opcional; padrões em credenciais-dev-local.md)
# =============================================================================

# --- URLs públicas (dev) — mesmas usadas no client Keycloak pelada-web ---
PELADA_WEB_URL=http://localhost:4200
PELADA_API_URL=http://localhost:3000
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=pelada
KEYCLOAK_CLIENT_ID=pelada-web

# Issuer OIDC (API valida JWT contra este realm)
KEYCLOAK_ISSUER=http://localhost:8080/realms/pelada
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/pelada/protocol/openid-connect/certs

# --- API (apps/api) ---
API_PORT=3000
PORT=3000
CORS_ORIGIN=http://localhost:4200
DATABASE_URL=postgresql://pelada_app:pelada_app_dev@localhost:5433/pelada_app
# Postgres de teste (TEST-API-HARNESS): npm run db:test:up && npm run db:test:migrate
DATABASE_URL_TEST=postgresql://pelada_test:pelada_test_dev@localhost:5435/pelada_app_test
POSTGRES_APP_TEST_USER=pelada_test
POSTGRES_APP_TEST_PASSWORD=pelada_test_dev
POSTGRES_APP_TEST_PORT=5435
# Com API no Docker (npm run stack:up), o compose define DATABASE_URL interno e:
# KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/pelada/protocol/openid-connect/certs

# --- Postgres (Docker Compose — F0-7) ---
POSTGRES_APP_USER=pelada_app
POSTGRES_APP_PASSWORD=pelada_app_dev
POSTGRES_APP_PORT=5433
POSTGRES_KEYCLOAK_USER=keycloak
POSTGRES_KEYCLOAK_PASSWORD=keycloak_dev
POSTGRES_KEYCLOAK_PORT=5434

# --- Keycloak admin (só bootstrap local; produção = secrets no servidor) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=keycloak_admin_dev
KEYCLOAK_HTTP_PORT=8080

# Google IdP (opcional — habilitar no Admin Console após criar OAuth no Google Cloud)
# KEYCLOAK_GOOGLE_CLIENT_ID=
# KEYCLOAK_GOOGLE_CLIENT_SECRET=

# --- Opcional: bypass de auth só em dev (F0-5) — NUNCA true em staging/prod ---
DEV_AUTH_BYPASS=false
# DEV_AUTH_SUB=uuid-fixo-para-testes-api

# --- Rate limit (Médio M3): só "true" quando a API fica atrás de um
# reverse proxy único (staging — docker-compose.staging.yml já define).
# NUNCA true sem proxy na frente: habilita confiar em X-Forwarded-For. ---
TRUST_PROXY=false

# --- Upload MVP (STORAGE-1) ---
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:3000/uploads

# --- E2E (Playwright — issue E2E-1); stack + dev:web rodando ---
# PELADA_WEB_URL=http://localhost:4200
# PELADA_API_URL=http://localhost:3000
# E2E_KC_USER=dev
# E2E_KC_PASSWORD=dev-pelada-local

# --- Staging / deploy (não usar em dev puro) ---
# Ver .env.staging.example (DEPLOY-1): STAGING_* / KEYCLOAK_PUBLIC_HOSTNAME
